@page
@model TicketManagement.Bsui.Pages.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}

<h2>Dashboard Summary</h2>

<div class="row mb-4" id="summaryCards">
    <div class="col">
        <div class="card text-center p-3">
            <h6>Total Tiket</h6>
            <h3 id="totalTickets">-</h3>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <h6>Open</h6>
            <h3 id="openCount">-</h3>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <h6>In Progress</h6>
            <h3 id="inProgressCount">-</h3>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <h6>Resolved</h6>
            <h3 id="resolvedCount">-</h3>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <h6>Closed</h6>
            <h3 id="closedCount">-</h3>
        </div>
    </div>
</div>

<h4>Beban Kerja per Agent</h4>
<table class="table table-bordered">
    <thead>
        <tr><th>Nama Agent</th><th>Jumlah Tiket Ditugaskan</th></tr>
    </thead>
    <tbody id="workloadTableBody"></tbody>
</table>

@section Scripts {
    <script src="~/js/dashboard.js"></script>
}