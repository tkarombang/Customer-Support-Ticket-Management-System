@page
@model TicketManagement.Bsui.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Dashboard";
    ViewData["Active"] = "Dashboard"; 
}

<h2>Dashboard Summary</h2>
<div class="row mb-4" id="summaryCards">
    <div class="col">
        <div class="card text-center p-3">
            <div class="sub-card">
                <i class="fa-solid fa-ticket total-color"></i>
                <div>
                    <h6>Total Tiket</h6>
                    <h3 id="totalTickets">-</h3>
                </div>
            </div>
            <span id="totalChange" class="stat-change">-</span>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <div class="sub-card">
                <i class="fa-solid fa-square-up-right resolved-color"></i>
                <div>
                    <h6>Resolved</h6>
                    <h3 id="resolvedCount">-</h3>
                </div>
            </div>
            <span id="resolvedChange" class="stat-change">-</span>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <div class="sub-card">
                <i class="fa-solid fa-bars-progress progress-color"></i>
                <div>
                    <h6>In Progress</h6>
                    <h3 id="inProgressCount">-</h3>
                </div>
            </div>
            <span id="inProgressChange" class="stat-change">-</span>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <div class="sub-card">
                <i class="fa-solid fa-rectangle-xmark closed-color"></i>
                <div>
                    <h6>Closed</h6>
                    <h3 id="closedCount">-</h3>
                </div>
            </div>
            <span id="closedChange" class="stat-change">-</span>
        </div>
    </div>
    <div class="col">
        <div class="card text-center p-3">
            <div class="sub-card">
                <i class="fa-solid fa-folder-open open-color"></i>
                <div>
                    <h6>Open</h6>
                    <h3 id="openCount">-</h3>
                </div>
            </div>
            <span id="openChange" class="stat-change">-</span>
        </div>
    </div>
    @* <div class="col">
        <div class="card text-center p-3">
            <h6>Total Users</h6>
            <h3 id="workloadPerAgent">-</h3>
        </div>
    </div> *@
</div>


<div class="row mt-3">
    <div class="col" style="flex:1;">
        <div class="card">
            <h6>Tickets per Status</h6>
            <div class="chart-container chart-sm"><canvas id="chartDashStatus"></canvas></div>
        </div>
    </div>
    <div class="col" style="flex:2;">
        <div class="card">
            <h6>Tickets Trend</h6>
            <div class="chart-container chart-sm"><canvas id="chartDashTrend"></canvas></div>
        </div>
    </div>
</div>

<div class="report-grid">
    <div class="card span-4">
        <h4 class="mt-3">Beban Kerja per Agent</h4>
        <div class="chart-container"><canvas id="chartDashAssignee"></canvas></div>
    </div>
</div>


