<div class="report-grid-dashboard">
    <div class="card span-2">
        <div class="card-header-custom">
            <h6>Recent Tickets</h6>
        </div>

        <div class="table-responsive">
            <table class="table-mini" id="recentTicketsTable"></table>
        </div>

        <a href="/Tickets" class="link-more">
            Lihat semua tiket
            <i class="fa-solid fa-angles-right"></i>
        </a>
    </div>

    <div class="card span-2">
        <div class="card-header-custom">
            <h6>Ticket Activities (History)</h6>
        </div>

        <div id="activityTimeline"></div>

        <a href="/TicketHistories" class="link-more">
            Lihat semua riwayat
            <i class="fa-solid fa-angles-right"></i>
        </a>
    </div>
</div>


