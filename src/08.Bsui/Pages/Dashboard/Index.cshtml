    <div class="card span-2">
        <h6>Recent Tickets</h6>
        <table class="table-mini mb-3" id="recentTicketsTable"></table>
        <a href="/Tickets" class="link-more">Lihat semua tiket<i class="fa-solid fa-angles-right"></i></a>
