@page
@model TicketManagement.Bsui.Pages.Reports.IndexModel
@{
    ViewData["Title"] = "Reports";
    ViewData["Active"] = "Reports";
}
<div class="toolbar-header mb-3">
    <div>
        <h2>Reports</h2>
        <p class="text-muted">Laporan dan analisis data tiket</p>
    </div>
    <div class="toolbar-actions">
        <input id="reportStartDate" type="date" class="form-control" style="max-width:150px;" />
        <span class="text-muted">s/d</span>
        <input id="reportEndDate" type="date" class="form-control" style="max-width:150px;" />
        <button id="btnApplyDateRange" type="button" class="btn btn-secondary">Terapkan</button>
        <button id="btnReset" type="button" class="btn btn-outline-secondary">Reset</button>
        <button id="btnExport" type="button" class="btn btn-primary">⬇ Export</button>
    </div>
</div>

<div class="tabs mb-3">
    <button class="tab-btn active" data-tab="overview">Overview</button>
    <button class="tab-btn" data-tab="tickets">Tickets</button>
    <button class="tab-btn" data-tab="performance">Performance</button>
    <button class="tab-btn" data-tab="sla">SLA</button>
</div>

<!-- Tab: Overview -->
<div id="tab-overview" class="tab-panel">
    <div class="row mb-3">
        <div class="col"><div class="card"><h6>Total Tickets</h6><h3 id="ov-total">-</h3></div></div>
        <div class="col"><div class="card"><h6>Tickets Selesai</h6><h3 id="ov-resolved">-</h3></div></div>
        <div class="col"><div class="card"><h6>Dalam Proses</h6><h3 id="ov-inprogress">-</h3></div></div>
        <div class="col"><div class="card"><h6>Closed / Cancelled</h6><h3 id="ov-closed">-</h3></div></div>
    </div>
    <div class="report-grid">
        <div class="card span-2">
            <h6>Tickets per Status</h6>
            <div class="chart-container chart-md">
                <canvas id="chartStatusDonut"></canvas>
            </div>
        </div>
        <div class="card span-2">
            <h6>Tickets Trend</h6>
            <div class="chart-container chart-md">
                <canvas id="chartTrend"></canvas>
            </div>
        </div>
    </div>

    <div class="report-grid">
        <div class="card span-2">
            <h6>Tickets per Assigne (Top 6)</h6>
            <div class="chart-container chart-md">
                <canvas id="chartAssignee"></canvas>
            </div>
        </div>
        <div class="card">
            <h6>Tickets per Category</h6>
            <div class="chart-container chart-md">
                <canvas id="chartCategory"></canvas>
            </div>
        </div>
        <div class="card">
            <h6>Tickets per Priority</h6>
            <div class="chart-container chart-md">
                <canvas id="chartPriority"></canvas>
            </div>
        </div>
    </div>

    <div class="report-grid">
        <div class="card">
            <h6>Average Response Time</h6>
            <h3 id="ov-avgHours">-</h3>
            <span class="text-muted" style="font-size:12px;">Rata-rata waktu respons</span>
        </div>
        <div class="card">
            <h6>SLA Compliance</h6>
            <h3 id="ov-slaPercentage">-</h3>
            <span class="text-muted" style="font-size:12px;"><span id="ov-slaWithin">-</span>/<span id="ov-slaTotal">-</span> tiket</span>
        </div>
        <div class="card span-2">
            <h6>Tickets by Category</h6>
            <table class="table-mini" id="categoryTable"></table>
        </div>
    </div>

    <div class="report-grid">
        <div class="card span-2">
            <h6>Recent Closed Tickets</h6>
            <table class="table-mini" id="recentClosedTable"></table>
        </div>
        <div class="card span-2">
            <h6>SLA Compliance Trend</h6>
            <div class="chart-container chart-md">
                <canvas id="chartSlaTrend" height="180"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Tab: Tickets -->
<div id="tab-tickets" class="tab-panel" style="display:none;">
    <table class="table">
        <thead><tr><th>Ticket Number</th><th>Title</th><th>Status</th><th>Assignee</th><th>Created</th></tr></thead>
        <tbody id="reportTicketsBody"></tbody>
    </table>
</div>

<!-- Tab: Performance -->
<div id="tab-performance" class="tab-panel" style="display:none;">
    <div class="row">
        <div class="col">
            <div class="card">
                <h6>Average Response Time</h6>
                <h3 id="perf-avgHours">-</h3>
                <span class="text-muted" style="font-size:12px;">Rata-rata waktu respons (jam)</span>
            </div>
        </div>
    </div>
</div>

<!-- Tab: SLA -->
<div id="tab-sla" class="tab-panel" style="display:none;">
    <div class="row">
        <div class="col">
            <div class="card">
                <h6>SLA Compliance</h6>
                <h3 id="sla-percentage">-</h3>
                <span class="text-muted" style="font-size:12px;">
                    <span id="sla-within">-</span> dari <span id="sla-total">-</span> tiket memenuhi SLA
                </span>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <h6>Breached SLA</h6>
                <h3 id="sla-breached">-</h3>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/reports.js"></script>
}