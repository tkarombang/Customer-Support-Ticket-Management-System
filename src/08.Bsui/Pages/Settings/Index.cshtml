@page
@model TicketManagement.Bsui.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["Active"] = "Settings";
}

<h2>Settings</h2>
<p class="text-muted">Kelola konfigurasi sistem</p>

<div class="tabs mb-3">
    <button class="tab-btn active" data-tab="general">General</button>
    <button class="tab-btn" data-tab="sla">SLA</button>
    <button class="tab-btn" data-tab="integrations">Integrations</button>
    <button class="tab-btn" data-tab="backup">Backup & Restore</button>
    <button class="tab-btn" data-tab="logs">System Logs</button>

</div>

<!-- General -->
<div id="tab-general" class="tab-panel">
    <div class="card" style="max-width:600px;">
        <div class="mb-2"><label>Nama Aplikasi</label><input id="gen-appName" class="form-control" /></div>
        <div class="mb-2"><label>Deskripsi</label><textarea id="gen-appDesc" class="form-control" rows="2"></textarea></div>
        <div class="row mb-2">
            <div class="col"><label>Zona Waktu</label><input id="gen-timezone" class="form-control" /></div>
            <div class="col"><label>Bahasa</label><input id="gen-language" class="form-control" /></div>
        </div>
        <div class="row mb-2">
            <div class="col"><label>Format Tanggal</label><input id="gen-dateFormat" class="form-control" /></div>
            <div class="col"><label>Item per Halaman</label><input id="gen-itemsPerPage" type="number" class="form-control" /></div>
        </div>
        <button id="btnSaveGeneral" type="button" class="btn btn-primary">Simpan Perubahan</button>
    </div>
</div>

<!-- SLA -->
<div id="tab-sla" class="tab-panel" style="display:none;">
    <div class="card" style="max-width:500px;">
        <div class="mb-2"><label>Target High Priority (jam)</label><input id="sla-high" type="number" class="form-control" /></div>
        <div class="mb-2"><label>Target Medium Priority (jam)</label><input id="sla-medium" type="number" class="form-control" /></div>
        <div class="mb-2"><label>Target Low Priority (jam)</label><input id="sla-low" type="number" class="form-control" /></div>
        <button id="btnSaveSla" type="button" class="btn btn-primary mt-3">Simpan Perubahan</button>
    </div>
</div>



<!-- Integrations -->
<div id="tab-integrations" class="tab-panel" style="display:none;">
    <button id="btnShowIntegrationForm" type="button" class="btn btn-primary mb-3">+ Tambah Integrasi</button>

    <div id="integrationForm" class="card mb-3" style="display:none; max-width:500px;">
        <div class="mb-2"><label>Nama</label><input id="int-name" class="form-control" /></div>
        <div class="mb-2"><label>Webhook URL</label><input id="int-webhook" class="form-control" /></div>
        <div class="mb-2"><label>API Key</label><input id="int-apikey" type="password" class="form-control" /></div>
        <button id="btnSaveIntegration" type="button" class="btn btn-success mt-3">Simpan</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Nama</th>
                <th>Webhook URL</th>
                <th>API Key</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody id="integrationTableBody"></tbody>
    </table>
</div>


<!-- Backup & Restore -->
<div id="tab-backup" class="tab-panel" style="display:none;">
    <div class="row mb-3">
        <div class="col">
            <div class="card">
                <h6>Manual Backup</h6>
                <p class="text-muted" style="font-size:13px;">Buat cadangan database saat ini.</p>
                <button id="btnTriggerBackup" type="button" class="btn btn-primary">Backup Sekarang</button>
            </div>
        </div>
        <div class="col">
            <div class="card">
                <h6>Restore Database</h6>
                <p class="text-muted" style="font-size:13px;">⚠️ Ini akan menimpa data saat ini.</p>
                <input id="restoreFile" type="file" class="form-control mb-2" accept=".bak" />
                <button id="btnRestore" type="button" class="btn btn-secondary">Restore</button>
            </div>
        </div>
    </div>

    <h6>Riwayat Backup</h6>
    <table class="table">
        <thead><tr><th>File Name</th><th>Ukuran</th><th>Tipe</th><th>Status</th><th>Tanggal</th></tr></thead>
        <tbody id="backupTableBody"></tbody>
    </table>
</div>



<!-- System Logs -->
<div id="tab-logs" class="tab-panel" style="display:none;">
    <div class="filter-bar mb-3">
        <input id="log-search" class="form-control" placeholder="Cari deskripsi..." style="max-width:220px;" />
        <select id="log-action" class="form-control" style="max-width:180px;">
            <option value="">Semua Action</option>
            <option value="Login">Login</option>
            <option value="UpdateProfile">Update Profile</option>
            <option value="ChangePassword">Change Password</option>
            <option value="CreateTicket">Create Ticket</option>
            <option value="UpdateTicket">Update Ticket</option>
            <option value="UpdateSettings">Update Settings</option>
        </select>
        <button id="btnFilterLogs" type="button" class="btn btn-secondary">Filter</button>
        <button id="btnResetLogs" type="button" class="btn btn-outline-secondary">Reset</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>User</th>
                <th>Action</th>
                <th>Deskripsi</th>
                <th>IP Address</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody id="logTableBody"></tbody>
    </table>
    <div id="logPaginationInfo" class="text-muted mt-2" style="font-size:13px;"></div>
</div>

<script>
    const initialTab = '@ViewData["InitialTab"]';
</script>
@section Scripts {
    <script src="~/js/settings.js"></script>
}