@page
@model TicketManagement.Bsui.Pages.Settings.IndexModel
@{
    ViewData["Title"] = "Settings";
    ViewData["Active"] = "Settings";
}

<h2>Settings</h2>
<p class="text-muted">Kelola konfigurasi sistem</p>

<div class="tabs mb-3">
    <button class="tab-btn active" data-tab="general">General</button>
    <button class="tab-btn" data-tab="sla">SLA</button>
    <button class="tab-btn" data-tab="integrations">Integrations</button>
</div>

<!-- General -->
<div id="tab-general" class="tab-panel">
    <div class="card" style="max-width:600px;">
        <div class="mb-2"><label>Nama Aplikasi</label><input id="gen-appName" class="form-control" /></div>
        <div class="mb-2"><label>Deskripsi</label><textarea id="gen-appDesc" class="form-control" rows="2"></textarea></div>
        <div class="row mb-2">
            <div class="col"><label>Zona Waktu</label><input id="gen-timezone" class="form-control" /></div>
            <div class="col"><label>Bahasa</label><input id="gen-language" class="form-control" /></div>
        </div>
        <div class="row mb-2">
            <div class="col"><label>Format Tanggal</label><input id="gen-dateFormat" class="form-control" /></div>
            <div class="col"><label>Item per Halaman</label><input id="gen-itemsPerPage" type="number" class="form-control" /></div>
        </div>
        <button id="btnSaveGeneral" type="button" class="btn btn-primary">Simpan Perubahan</button>
    </div>
</div>

<!-- SLA -->
<div id="tab-sla" class="tab-panel" style="display:none;">
    <div class="card" style="max-width:500px;">
        <div class="mb-2"><label>Target High Priority (jam)</label><input id="sla-high" type="number" class="form-control" /></div>
        <div class="mb-2"><label>Target Medium Priority (jam)</label><input id="sla-medium" type="number" class="form-control" /></div>
        <div class="mb-2"><label>Target Low Priority (jam)</label><input id="sla-low" type="number" class="form-control" /></div>
        <button id="btnSaveSla" type="button" class="btn btn-primary mt-3">Simpan Perubahan</button>
    </div>
</div>



<!-- Integrations -->
<div id="tab-integrations" class="tab-panel" style="display:none;">
    <button id="btnShowIntegrationForm" type="button" class="btn btn-primary mb-3">+ Tambah Integrasi</button>

    <div id="integrationForm" class="card mb-3" style="display:none; max-width:500px;">
        <div class="mb-2"><label>Nama</label><input id="int-name" class="form-control" /></div>
        <div class="mb-2"><label>Webhook URL</label><input id="int-webhook" class="form-control" /></div>
        <div class="mb-2"><label>API Key</label><input id="int-apikey" type="password" class="form-control" /></div>
        <button id="btnSaveIntegration" type="button" class="btn btn-success">Simpan</button>
    </div>

    <table class="table">
        <thead>
            <tr>
                <th>Nama</th>
                <th>Webhook URL</th>
                <th>API Key</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody id="integrationTableBody"></tbody>
    </table>
</div>

@section Scripts {
    <script src="~/js/settings.js"></script>
}