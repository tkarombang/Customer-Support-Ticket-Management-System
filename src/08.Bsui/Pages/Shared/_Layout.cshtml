@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TicketManagement.Bsui</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @* <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /> *@
    @* <link rel="stylesheet" href="~/TicketManagement.Bsui.styles.css" asp-append-version="true" /> *@
</head>
<body>
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <span class="brand-icon">▤</span>
                <span class="brand-text">Ticket System</span>
            </div>

            <nav class="sidebar-nav">
                <a href="/Dashboard" class="nav-item @(ViewData["Active"]?.ToString() == "Dashboard" ? "active" : "")">
                    <span class="nav-icon">⌂</span>
                    <span class="brand-text">Dashboard</span>
                </a>

                <div class="nav-section-label">MENU</div>
                <a href="/Tickets" class="nav-item @(ViewData["Active"]?.ToString() == "Tickets" ? "active" : "")">
                    <span class="nav-icon">▤</span>
                    <span class="brand-text">Tickets</span>
                </a>
                <a href="/TicketHistories" class="nav-item @(ViewData["Active"]?.ToString() == "TicketHistories" ? "active" : "")">
                    <span class="nav-icon">◷</span>
                    <span class="brand-text">Ticket Histories</span>
                </a>
                <a href="/Users" class="nav-item @(ViewData["Active"]?.ToString() == "Users" ? "active" : "")">
                    <span class="nav-icon">☺</span>
                    <span class="brand-text">Users</span>
                </a>
                <a href="/Reports" class="nav-item @(ViewData["Active"]?.ToString() == "Reports" ? "active" : "")">
                    <span class="nav-icon">▥</span>
                    <span class="brand-text">Reports</span>
                </a>

                <div class="nav-section-label">SETTINGS</div>
                <a href="/Profile" class="nav-item @(ViewData["Active"]?.ToString() == "Profile" ? "active" : "")">
                    <span class="nav-icon">☺</span>
                    <span class="brand-text">Profile</span>
                </a>
                <a href="/Settings" class="nav-item @(ViewData["Active"]?.ToString() == "Settings" ? "active" : "")">
                    <span class="nav-icon">⚙</span>
                    <span class="brand-text">Profile</span>
                </a>
            </nav>


            <a href="/Logout" class="nav-item logout-item">
                <span class="nav-icon">⏻</span>
                <span class="brand-text">Logout</span>
            </a>
        </aside>

        <main class="main-content">
            <header class="topbar">
                <button class="hamburger" id="sidebarToggle">☰</button>
                <div class="topbar-spacer"></div>
                <div class="user-chip">
                    <div class="user-avatar">@(HttpContextAccessor.HttpContext?.Session.GetString("Name")?.Substring(0,1).ToUpper() ?? "U")</div>
                    <div class="user-info">
                        <div class="user-name">@HttpContextAccessor.HttpContext?.Session.GetString("Name")</div>
                        <div class="user-role">@HttpContextAccessor.HttpContext?.Session.GetString("Role")</div>
                    </div>
                </div>
            </header>

            <div class="page-body">
                @RenderBody()
            </div>
        </main>
    </div>

    <footer style="padding:20px; background:#f8f9fa; border-top:1px solid #dee2e6;">
        © 2026 - Ticket Management - Created by Muhammad Azwar Anas
    </footer>
    @Html.AntiForgeryToken()
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: true)
    @* <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script> *@

</body>
</html>
