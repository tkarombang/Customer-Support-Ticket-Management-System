@page
@Html.AntiForgeryToken()
@model TicketManagement.Bsui.Pages.Users.IndexModel
@{
    ViewData["Title"] = "Users";
}

<h2>Users</h2>
<p class="text-muted">Kelola pengguna sistem</p>

<div class="row mb-3" id="summaryCards">
    <div class="col"><div class="card text-center p-3"><h6>Total Users</h6><h3 id="totalUsers">-</h3></div></div>
    <div class="col"><div class="card text-center p-3"><h6>Active</h6><h3 id="activeUsers">-</h3></div></div>
    <div class="col"><div class="card text-center p-3"><h6>Inactive</h6><h3 id="inactiveUsers">-</h3></div></div>
</div>

<button id="btnShowCreate" class="btn btn-primary mb-3">+ Tambah User</button>

<div id="createForm" class="card p-3 mb-3" style="display:none;">
    <div class="row g-2">
        <div class="col"><input id="username" class="form-control" placeholder="Username" /></div>
        <div class="col"><input id="name" class="form-control" placeholder="Nama Lengkap" /></div>
        <div class="col"><input id="email" class="form-control" placeholder="Email" /></div>
        <div class="col"><input id="password" type="password" class="form-control" placeholder="Password" /></div>
        <div class="col">
            <select id="role" class="form-control">
                <option value="Administrator">Administrator</option>
                <option value="Agent" selected>Agent</option>
                <option value="Viewer">Viewer</option>
            </select>
        </div>
        <div class="col-auto"><button type="button" id="btnSubmitCreate" class="btn btn-success">Simpan</button></div>
    </div>
</div>

<table class="table table-bordered">
    <thead>
        <tr><th>Username</th><th>Nama</th><th>Email</th><th>Role</th><th>Status</th><th>Aksi</th></tr>
    </thead>
    <tbody id="userTableBody"></tbody>
</table>

@section Scripts {
    <script src="~/js/users.js"></script>
}